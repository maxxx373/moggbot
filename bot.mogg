const LESSONS = [
  { id: 'l1', t: 'Внешность — это не лицо', min: 3, art: 'a1', body: [
    'Когда говорят «внешность», обычно думают о чертах лица. Но первое впечатление складывается из десятков сигналов: осанка, кожа, волосы, одежда, запах, походка, голос, взгляд.',
    'Черты лица — лишь часть картины, и как раз её мы не трогаем. Зато почти всё остальное в твоих руках, и это не мелочи: именно они делают человека «приятным», «собранным» и «стильным».',
    { q: 'Мы не меняем то, что дала природа. Мы выжимаем максимум из всего остального.' },
    { h: 'Что это значит на практике' },
    'Вместо вопроса «красивый ли я?» задавай вопрос «что я сегодня сделал для себя?». На первый ответить нельзя, на второй — каждый день.'
  ] },
  { id: 'l2', t: 'Почему ты не нравишься себе на фото', min: 3, art: 'a2', body: [
    'В зеркале ты видишь отражённую версию себя — и привык именно к ней. На фото лицо развёрнуто так, как его видят другие, и мозгу это кажется «неправильным». Психологи называют это эффектом знакомства: нам больше нравится то, что мы видим чаще.',
    'Вторая причина — фронтальная камера. С расстояния 30 см широкоугольный объектив искажает пропорции: нос кажется крупнее, лицо — уже.',
    { h: 'Как снимать прогресс' },
    'Расстояние 1–1,5 метра, зум ×2, дневной свет из окна, лицо прямо. Одни и те же условия каждую неделю — иначе сравнивать бессмысленно.'
  ] },
  { id: 'l3', t: 'Эффект ореола', min: 2, art: 'a3', body: [
    'Эффект ореола — это когда одна заметная черта влияет на оценку всего человека. Опрятный вид люди бессознательно связывают с дисциплиной, надёжностью и уверенностью.',
    { q: 'Базовая ухоженность даёт непропорционально много.' },
    'Чистая кожа, свежая стрижка, вещи по размеру и прямая спина почти ничего не стоят, но меняют то, как тебя воспринимают с первых секунд.'
  ] },
  { id: 'l4', t: 'Перестань сравнивать', min: 2, art: 'a4', body: [
    'В соцсетях ты видишь лучший кадр из сотни: с правильным светом, ракурсом и фильтрами. Сравнивать с этим свою обычную жизнь — заведомо проигрышная игра.',
    'Единственное честное сравнение — ты сегодня и ты месяц назад. Для этого в приложении есть фото прогресса.',
    { h: 'Правило' },
    'Если после ленты тебе хуже, чем до неё, — это не мотивация, а шум. Отписывайся без жалости.'
  ] },
  { id: 'l5', t: 'Система сильнее мотивации', min: 3, art: 'a5', body: [
    'Мотивация скачет: сегодня горишь, завтра лень. Привычки работают, даже когда настроения нет.',
    'Поэтому здесь три маленьких задания в день вместо часа раз в неделю. Маленькое действие легко повторить, а повторение и даёт результат.',
    { q: 'Не разрывай цепочку. Серия — твой главный инструмент.' },
    'Пропустил день — не страшно. Пропустил два подряд — это уже начало новой привычки, только плохой.'
  ] },
  { id: 'l6', t: 'С чего начать прямо сегодня', min: 2, art: 'a6', body: [
    'Пять вещей с максимальной отдачей и минимальными затратами:',
    { h: '01 · Сон 7–8 часов' }, 'Без этого остальное работает вполсилы.',
    { h: '02 · Умывание, крем, SPF' }, 'Три шага ухода — база на годы вперёд.',
    { h: '03 · Свежая стрижка' }, 'Найди мастера и стригись регулярно.',
    { h: '04 · Вещи по размеру' }, 'Посадка важнее бренда.',
    { h: '05 · Осанка' }, 'Две минуты у стены в день.'
  ] }
];
const MIND = [
  { id: 'm1', t: 'Держи слово', min: 2, art: 'a12', body: [
    'Самый недооценённый навык — просто делать то, что сказал. Люди редко помнят, что ты обещал, но всегда помнят, сделал ли ты это.',
    { q: 'Репутация — это сумма выполненных маленьких обещаний.' },
    { h: 'Практика' },
    'Начни с мелочей: сказал «перезвоню через час» — перезвони. Сказал «приду к семи» — будь в 18:55. Обещай меньше, делай больше.'
  ] },
  { id: 'm2', t: 'Без оправданий', min: 2, art: 'a5', body: [
    'Ответственность — это не чувство вины. Это вопрос «что я могу сделать?» вместо «кто виноват?».',
    'Оправдание звучит как объяснение, но на деле снимает с тебя контроль. Если виноваты обстоятельства, то и изменить ничего нельзя.',
    { h: 'Челлендж на неделю' },
    'Убери из речи «не успел, потому что…». Замени на «не сделал. Сделаю к…». Звучит жёстче — и работает лучше.'
  ] },
  { id: 'm3', t: 'Сила — в уважении', min: 2, art: 'a3', body: [
    'Уверенным людям не нужно унижать других. Подколы в адрес слабых — почти всегда признак неуверенности.',
    'Лучший тест характера — как ты общаешься с официантом, курьером, младшими. Это видят все, даже если молчат.',
    { q: 'Вежливость ничего не стоит, а впечатление производит сильнее любого образа.' }
  ] },
  { id: 'm4', t: 'Как переживать провалы', min: 3, art: 'a2', body: [
    'Неудача — это данные, а не приговор. Ошибаются все; разница в том, что человек делает дальше.',
    { h: 'Разбор в три вопроса' },
    'Что произошло? Что из этого зависело от меня? Что я сделаю иначе в следующий раз?',
    { h: 'Правило 24 часов' },
    'Сутки можно злиться и расстраиваться. Потом — разбор и следующий шаг.'
  ] },
  { id: 'm5', t: 'Замечай хорошее', min: 2, art: 'a4', body: [
    'Мозг лучше запоминает плохое — так устроено внимание. Поэтому хорошее приходится замечать специально.',
    'Психологи связывают привычку благодарности с более высоким уровнем удовлетворённости жизнью.',
    { h: 'Практика' },
    'Каждый вечер — три вещи, которые сегодня получились или порадовали. Для этого на втором уровне открывается дневник благодарности.'
  ] }
];
const SOCIAL = [
  { id: 's1', t: 'Взгляд и улыбка', min: 2, art: 'a13', body: [
    'Первое впечатление складывается за секунды, и до слов дело ещё не дошло. Работают взгляд, улыбка и поза.',
    { h: 'Как смотреть' },
    'Держи зрительный контакт, пока говорит собеседник. Когда говоришь сам — можно чаще отводить взгляд. Не сверли и не бегай глазами.',
    { q: 'Улыбнись при приветствии. Это самый дешёвый апгрейд образа.' }
  ] },
  { id: 's2', t: 'Как начать разговор', min: 3, art: 'a1', body: [
    'Лучший повод — общий контекст: место, событие, ситуация. Комментарий о ней плюс открытый вопрос.',
    'Открытые вопросы начинаются с «как», «что», «почему» — на них не ответишь «да» или «нет».',
    { h: 'Примеры' },
    '«Ты уже был здесь раньше? Что посоветуешь?» · «Как ты вообще попал в эту тему?» · «Что из этого тебе больше всего понравилось?»'
  ] },
  { id: 's3', t: 'Слушать, а не ждать очереди', min: 2, art: 'a4', body: [
    'Большинство людей слушают, чтобы ответить. Сильный собеседник слушает, чтобы понять.',
    { h: 'Активное слушание' },
    'Не перебивай. Уточняй: «то есть ты имеешь в виду…?». Возвращайся к деталям: «ты говорил про…».',
    { q: 'Люди забывают, что ты сказал, но помнят, как ты дал им себя почувствовать.' }
  ] },
  { id: 's4', t: 'Страх отказа', min: 3, art: 'a5', body: [
    'Отказ — это реакция на предложение, а не оценка тебя как человека. У собеседника тысяча своих причин.',
    'Страх уходит через практику маленькими шагами: спроси дорогу, сделай комплимент бариста, задай вопрос на паре.',
    { h: 'Челлендж' },
    'Одно маленькое «социальное» действие в день. Через пару недель станет заметно легче.'
  ] },
  { id: 's5', t: 'Язык тела', min: 2, art: 'a6', body: [
    'Открытая поза: руки не скрещены, телефон в кармане, корпус развёрнут к собеседнику.',
    'Ровная спина и спокойный темп речи читаются как уверенность. Тут помогает и работа над осанкой.',
    { q: 'Говори чуть медленнее, чем хочется. Спешка читается как волнение.' }
  ] }
];
