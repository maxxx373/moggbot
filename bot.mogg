const ARTICLES = [
  { id: 'f1', tag: 'Мода', t: 'Как устроены недели моды', min: 4, art: 'a7', body: [
    'Главные недели моды — «большая четвёрка»: Нью-Йорк, Лондон, Милан и Париж. Они идут друг за другом дважды в год.',
    'Хитрость в том, что показывают на сезон вперёд: коллекции осень-зима выходят на подиум в феврале–марте, весна-лето — в сентябре–октябре. То, что ты видишь на показе сегодня, попадёт в магазины через полгода.',
    { h: 'Зачем тебе это' },
    'Показы задают направление: силуэты, цвета, настроение. Через год-два эти идеи доходят до масс-маркета. Кто следит за показами, видит тренды раньше остальных.'
  ] },
  { id: 'f2', tag: 'Тренд', t: 'Gorpcore: почему все носят походные куртки', min: 3, art: 'a8', body: [
    'Gorpcore — стиль, в котором вещи для гор и походов носят в городе: флиски, ветровки, трекинговые кроссовки, карго-штаны.',
    'Спортивно-технические бренды стали модными, потому что их вещи практичные, долговечные и выглядят «как будто ты только что с вершины».',
    { q: 'Функция стала эстетикой.' },
    'Как носить: одна техническая вещь плюс спокойная база. Полный комплект «как на Эверест» в метро выглядит костюмом.'
  ] },
  { id: 'f3', tag: 'Стиль', t: 'Тихая роскошь без денег', min: 3, art: 'a9', body: [
    'Тихая роскошь — это вещи без логотипов, в спокойных цветах, хорошего качества и идеальной посадки. Дорого выглядит не бренд, а аккуратность.',
    { h: 'Как собрать на бюджете' },
    'Приглушённые цвета: бежевый, серый, тёмно-синий, белый. Ткани без катышков. Вещи строго по размеру — при необходимости ушить у портного, это недорого. Минимум принтов и надписей.'
  ] },
  { id: 'f4', tag: 'Стиль', t: 'Посадка решает: 5 правил', min: 2, art: 'a10', body: [
    'Шов плеча футболки или рубашки должен лежать на краю плеча, не ниже.',
    'Длина рукава рубашки — до основания большого пальца.',
    'Брюки не собираются гармошкой на обуви: максимум одна лёгкая складка.',
    'Футболка заканчивается примерно на середине ширинки.',
    'Куртка застёгивается без натяжения и не висит мешком.'
  ] },
  { id: 'f5', tag: 'Уход', t: 'Почему SPF — главный продукт ухода', min: 2, art: 'a11', body: [
    'Ультрафиолет — одна из главных причин раннего старения кожи: морщин, пигментных пятен, потери упругости. И он действует даже в пасмурную погоду.',
    { q: 'Лучший антивозрастной крем — тот, что защищает от солнца.' },
    'Выбирай SPF 30 или выше, наноси утром последним шагом ухода. Если долго на улице — обновляй каждые 2–3 часа.'
  ] }
];

// ---------- уровни и награды ----------
const MAX_LVL = 20;
const LV = (n) => 50 * (n - 1) * n; // сколько всего XP нужно для уровня n
const TITLES = [[1, 'Новичок'], [3, 'В процессе'], [5, 'Заметный'], [8, 'Стильный'], [12, 'Харизма'], [16, 'Легенда'], [20, 'Икона']];
const UNLOCKS = [
  { lvl: 2, id: 'grat', ic: '✍️', name: 'Дневник благодарности', d: 'Три хороших момента дня · +10 XP' },
  { lvl: 3, id: 't-sunset', ic: '🌅', name: 'Тема «Закат»', d: 'Тёплое оформление', theme: 'sunset' },
  { lvl: 4, id: 'week', ic: '🏆', name: 'Челленджи недели', d: 'Три задания на неделю · +60 XP за каждое' },
  { lvl: 5, id: 't-neon', ic: '🌌', name: 'Тема «Неон»', d: 'Ночной неон', theme: 'neon' },
  { lvl: 6, id: 'mood', ic: '🙂', name: 'Трекер настроения', d: 'Отмечай настроение и смотри график' },
