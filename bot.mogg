<!doctype html>
<html lang="ru" data-theme="matcha">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover,maximum-scale=1">
<title>Апгрейд</title>
<script src="https://telegram.org/js/telegram-web-app.js"></script>
<link rel="preconnect" href="https://fonts.googleapis.com">
<link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
<link href="https://fonts.googleapis.com/css2?family=Oswald:wght@500;600;700&family=Manrope:wght@400;500;600;700;800&family=JetBrains+Mono:wght@400;500;700&family=Permanent+Marker&display=swap" rel="stylesheet">
<style>
:root{
  --accent:#cde59b; --on-accent:#06101c;
  --bg:#080d14; --glow1:rgba(80,140,255,.16); --glow2:rgba(156,200,255,.08);
  --card:rgba(255,255,255,.035); --card-b:rgba(255,255,255,.08); --solid:#0f1620;
  --text:#eaf1f8; --hint:#8291a5; --line:rgba(255,255,255,.08);
  --ink:#000; --ink-text:#fff;
  --ok:#5ee6a8; --warn:#ffc35c; --danger:#ff6b6b; --gold:#ffd166;
  --disp:'Oswald',Impact,sans-serif; --mono:'JetBrains Mono',ui-monospace,monospace;
  --r:22px;
  --mA:#ffffff; --mB:#cfdcea; --mC:#5d7690; --mD:#e8f0f8; --mE:#2c3f55;
}
[data-theme="matcha"]{
  --bg:#141913; --glow1:rgba(168,195,140,.22); --glow2:rgba(230,200,120,.12);
  --card:rgba(240,250,225,.05); --card-b:rgba(225,240,205,.13); --solid:#1d241b;
  --text:#f2f6ea; --hint:#a5af9a; --line:rgba(225,240,205,.1);
  --ink:#0c100b;
  --mA:#f6fbe9; --mB:#c9dcae; --mC:#3b5234; --mD:#e2eecf; --mE:#223020;
}
[data-theme="sunset"]{
  --bg:#211915; --glow1:rgba(255,140,90,.22); --glow2:rgba(190,90,140,.18);
  --card:rgba(255,236,220,.05); --card-b:rgba(255,226,200,.12); --solid:#2c221d;
  --text:#fdf4ea; --hint:#bba795; --line:rgba(255,226,200,.1);
  --ink:#140e0c;
  --mA:#fff0e0; --mB:#f6b893; --mC:#6b3647; --mD:#ffd1b0; --mE:#3a2131;
}
[data-theme="neon"]{
  --bg:#09080f; --glow1:rgba(255,60,200,.22); --glow2:rgba(60,220,255,.16);
  --card:rgba(255,255,255,.04); --card-b:rgba(255,160,240,.15); --solid:#141225;
  --text:#f4f0ff; --hint:#958fb0; --line:rgba(255,255,255,.08);
  --ink:#000;
  --mA:#ffe0f7; --mB:#d08cff; --mC:#2a0f4a; --mD:#8af6ff; --mE:#150a2e;
}
[data-theme="sakura"]{
  --bg:#fbf0f1; --glow1:rgba(255,190,205,.6); --glow2:rgba(255,220,190,.45);
  --card:#ffffff; --card-b:rgba(90,30,50,.08); --solid:#ffffff;
  --text:#2a1418; --hint:#8f737a; --line:rgba(90,30,50,.08);
  --ink:#2a1418; --ink-text:#fff; --ok:#1f9d6b; --warn:#c98200;
  --mA:#ffffff; --mB:#ffdbe3; --mC:#b2617e; --mD:#ffeef2; --mE:#8a3f5c;
}
[data-theme="frost"]{
  --bg:#4e6276; --glow1:rgba(200,225,255,.22); --glow2:rgba(20,30,45,.35);
  --card:rgba(255,255,255,.08); --card-b:rgba(255,255,255,.16); --solid:#4a5f73;
  --text:#f4f8fc; --hint:#c3d0dd; --line:rgba(255,255,255,.16);
  --ink:#1d2935;
}
[data-theme="paper"]{
  --bg:#eef0f3; --glow1:rgba(255,255,255,.9); --glow2:rgba(0,0,0,0);
  --card:#ffffff; --card-b:rgba(0,0,0,.06); --solid:#ffffff;
  --text:#0b0b0c; --hint:#72767e; --line:rgba(0,0,0,.08);
  --ink:#0b0b0c; --ok:#12a26a; --warn:#d18b00;
}
*{box-sizing:border-box;-webkit-tap-highlight-color:transparent}
html,body{margin:0;color:var(--text);font:15px/1.5 'Manrope',-apple-system,BlinkMacSystemFont,'Segoe UI',Roboto,sans-serif;-webkit-font-smoothing:antialiased}
body{background:var(--bg);background-image:radial-gradient(120% 60% at 100% 0%,var(--glow1),transparent 60%),radial-gradient(90% 50% at 0% 100%,var(--glow2),transparent 60%);background-attachment:fixed;min-height:100vh;transition:background-color .4s}
button{font:inherit;color:inherit;border:0;background:none;cursor:pointer;padding:0}
input{font:inherit;color:var(--text)}
.app{max-width:520px;margin:0 auto;min-height:100vh;padding:14px 16px 110px}
.app.no-tabs{padding-bottom:28px}

/* типографика */
.disp{font-family:var(--disp);text-transform:uppercase;font-weight:700;letter-spacing:-.005em;line-height:.92}
.mono{font-family:var(--mono);font-size:10.5px;letter-spacing:.09em;text-transform:uppercase;color:var(--hint)}
.h1{font-size:46px}
.hint{color:var(--hint);font-size:13.5px}
.tm{font-size:.42em;vertical-align:super;margin-left:2px;font-family:var(--mono);font-weight:500}

/* базовые блоки */
.row{display:flex;align-items:center;gap:10px}
.between{justify-content:space-between}
.card{background:var(--card);border:1px solid var(--card-b);border-radius:var(--r);padding:16px;margin-bottom:12px;backdrop-filter:blur(14px);-webkit-backdrop-filter:blur(14px)}
[data-theme="paper"] .card,[data-theme="sakura"] .card{box-shadow:0 1px 2px rgba(0,0,0,.03),0 10px 30px rgba(0,0,0,.04)}
.ink{background:var(--ink);color:var(--ink-text);border-color:transparent}
.ink .mono,.ink .hint{color:rgba(255,255,255,.55)}
.sec{display:flex;align-items:flex-end;justify-content:space-between;margin:24px 2px 10px}
.sec .disp{font-size:24px}

.btn{display:flex;align-items:center;justify-content:center;gap:10px;width:100%;height:56px;border-radius:18px;background:var(--accent);color:var(--on-accent);font-weight:800;font-size:15px;letter-spacing:.02em;transition:transform .12s,opacity .2s,background .3s}
.btn[disabled]{opacity:.35;pointer-events:none}
.btn.ghost{background:var(--card);border:1px solid var(--card-b);color:var(--text)}
.btn.sm{height:38px;width:auto;padding:0 16px;font-size:13px;border-radius:12px}
.pillbtn{display:inline-flex;align-items:center;gap:10px;height:40px;padding:0 6px 0 16px;border-radius:40px;font-weight:700;font-size:13px}
.pillbtn i{width:30px;height:30px;border-radius:50%;display:grid;place-items:center;font-style:normal}
.arrow{width:40px;height:40px;border-radius:50%;border:1px solid var(--card-b);display:grid;place-items:center;flex:none;transition:transform .25s}
.arrow svg{width:16px;height:16px}
button:hover .arrow{transform:rotate(45deg)}
.iconbtn{width:44px;height:44px;border-radius:14px;background:var(--card);border:1px solid var(--card-b);display:grid;place-items:center;flex:none}
.iconbtn svg{width:20px;height:20px}
.lock{display:inline-grid;place-items:center;width:22px;height:22px;border-radius:7px;background:var(--card);border:1px solid var(--card-b)}
.lock svg{width:12px;height:12px}

/* шапка */
.top{display:flex;align-items:center;justify-content:space-between;margin-bottom:14px}
.logo{display:flex;align-items:center;gap:10px}
.logo svg{width:30px;height:30px;color:var(--accent)}
.logo b{font-family:var(--disp);font-size:22px;letter-spacing:.02em;text-transform:uppercase}
.lvl{display:inline-flex;align-items:center;gap:6px;height:30px;padding:0 10px;border-radius:10px;background:var(--card);border:1px solid var(--card-b);font-family:var(--mono);font-size:10.5px;letter-spacing:.06em;text-transform:uppercase}
.lvl em{font-style:normal;color:var(--accent);font-weight:700}
.lvl.gold{border-color:var(--gold);background:color-mix(in srgb,var(--gold) 14%,transparent);box-shadow:0 0 18px color-mix(in srgb,var(--gold) 35%,transparent)}
.lvl.gold em{color:var(--gold)}

/* hero */
.hero{position:relative;border-radius:28px;overflow:hidden;min-height:300px;background:linear-gradient(180deg,#0e1a2b 0%,#22374f 55%,#6f8aa6 100%);color:#fff;border:1px solid var(--card-b);margin-bottom:12px}
[data-theme="matcha"] .hero{background:linear-gradient(180deg,#1f2b1d 0%,#4e6a45 36%,#9fbc84 70%,#eef4d6 100%)}
[data-theme="sunset"] .hero{background:linear-gradient(180deg,#3a2238 0%,#93475c 34%,#ef9070 62%,#ffd0a0 100%)}
[data-theme="neon"] .hero{background:linear-gradient(180deg,#0d0b1f 0%,#3a1466 40%,#b02a8f 74%,#ff7ccf 100%)}
[data-theme="sakura"] .hero{background:linear-gradient(180deg,#a8506f 0%,#e2869f 45%,#f7b9c6 80%,#ffe3e8 100%)}
[data-theme="frost"] .hero{background:linear-gradient(180deg,#5a7189 0%,#8aa1b8 60%,#c9d6e2 100%)}
[data-theme="paper"] .hero{background:linear-gradient(180deg,#d9dee5 0%,#eef1f4 60%,#ffffff 100%);color:#0b0b0c}
.hero svg.mtn{position:absolute;left:0;right:0;bottom:0;width:100%;height:62%}
.shade{position:absolute;left:0;right:0;bottom:0;height:52%;background:linear-gradient(transparent,rgba(8,13,20,.82));z-index:1}
[data-theme="matcha"] .shade{height:42%;background:linear-gradient(transparent,rgba(16,24,14,.8))}
[data-theme="sunset"] .shade{height:40%;background:linear-gradient(transparent,rgba(40,20,24,.78))}
[data-theme="neon"] .shade{height:46%;background:linear-gradient(transparent,rgba(12,6,24,.85))}
[data-theme="sakura"] .shade{height:40%;background:linear-gradient(transparent,rgba(80,24,44,.62))}
[data-theme="paper"] .hero .shade{background:linear-gradient(transparent,rgba(255,255,255,.85))}
.hero .in{position:relative;z-index:2;padding:18px 18px 16px;display:flex;flex-direction:column;min-height:300px}
.hero .huge{font-size:92px;line-height:.95;margin-top:14px;letter-spacing:-.01em}
.hero .mono{color:currentColor;opacity:.75}
.hero .bot{margin-top:auto}
.track{height:4px;border-radius:4px;background:rgba(255,255,255,.22);overflow:hidden;margin-top:10px}
[data-theme="paper"] .track{background:rgba(0,0,0,.1)}
.track i{display:block;height:100%;background:currentColor;border-radius:4px;transform-origin:left}
.spark{position:absolute;bottom:20%;width:4px;height:4px;border-radius:50%;background:#fff;opacity:0;z-index:1;animation:spark 7s linear infinite;box-shadow:0 0 8px #fff}
@keyframes spark{0%{opacity:0;transform:translateY(0)}15%{opacity:.85}100%{opacity:0;transform:translateY(-220px) translateX(20px)}}

/* граффити и элементы FRZN */
.spray{position:absolute;font-family:'Permanent Marker',cursive;color:#fff;white-space:nowrap;pointer-events:none;z-index:1;line-height:1;filter:blur(.7px);opacity:.82;text-shadow:0 0 6px rgba(255,255,255,.9),0 0 18px rgba(255,255,255,.55),0 0 40px rgba(255,255,255,.3)}
[data-theme="sunset"] .spray{color:#fff6ec;text-shadow:0 0 6px rgba(255,240,225,.9),0 0 18px rgba(255,170,120,.65),0 0 40px rgba(255,110,90,.4)}
[data-theme="neon"] .spray{text-shadow:0 0 6px #fff,0 0 18px #ff5fd2,0 0 42px #39e6ff}
[data-theme="matcha"] .spray{text-shadow:0 0 6px #fff,0 0 18px rgba(220,240,180,.7),0 0 40px rgba(160,200,120,.4)}
[data-theme="paper"] .spray{color:#0b0b0c;opacity:.12;text-shadow:none}
.specs{display:flex;gap:18px;margin-top:12px}
.specs .k{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;text-transform:uppercase;opacity:.65}
.specs .v{font-family:var(--mono);font-size:11px;letter-spacing:.06em;text-transform:uppercase;margin-top:3px;font-weight:700}
.octa{position:relative;width:66px;height:66px;display:grid;place-items:center;color:inherit;flex:none;transition:transform .3s}
.octa:hover{transform:rotate(22.5deg)}
.octa svg.o{position:absolute;inset:0;width:100%;height:100%}
.octa .a{width:18px;height:18px}
.chipline{font-family:var(--mono);font-size:10px;letter-spacing:.08em;text-transform:uppercase;padding:5px 9px;border:1px solid var(--card-b);border-radius:8px;color:var(--text)}
.coll{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.cc{--c:var(--accent);position:relative;overflow:hidden;border-radius:18px;min-height:168px;padding:13px;display:flex;flex-direction:column;border:1px solid var(--card-b);background:linear-gradient(180deg,color-mix(in srgb,var(--c) 26%,transparent),color-mix(in srgb,var(--c) 4%,transparent) 70%)}
.cc.wide{grid-column:span 2;min-height:150px}
.cc .gh{position:absolute;right:-6px;bottom:-14px;font-family:var(--disp);font-weight:700;font-size:92px;line-height:.8;color:transparent;-webkit-text-stroke:1px color-mix(in srgb,var(--c) 55%,transparent);pointer-events:none}
.cc .disp{font-size:24px;margin-top:auto;position:relative}
.cc .mono{position:relative}
.dots{display:flex;gap:5px;margin:8px 0 6px;position:relative}
.dots i{width:9px;height:9px;border-radius:50%;border:1px solid var(--text);opacity:.6}
.dots i.on{background:var(--text);opacity:1}
.outro{position:relative;overflow:hidden;border-radius:28px;min-height:360px;margin-top:22px;padding:20px;color:#fff;background:linear-gradient(180deg,#3b4d60 0%,#6b829a 55%,#b9c8d6 100%);display:flex;flex-direction:column}
[data-theme="matcha"] .outro{background:linear-gradient(180deg,#1f2b1d,#4e6a45 55%,#b9d29c)}
[data-theme="sunset"] .outro{background:linear-gradient(180deg,#2a1b2e,#7a3f55 50%,#e8946e 85%,#ffcf9f)}
[data-theme="neon"] .outro{background:linear-gradient(180deg,#0d0b1f,#3a1466 50%,#c23a9c)}
[data-theme="sakura"] .outro{background:linear-gradient(180deg,#7e3553,#d97693 55%,#f9c4cf)}
[data-theme="ice"] .outro{background:linear-gradient(180deg,#0e1a2b,#2a4058 60%,#6f8aa6)}
[data-theme="paper"] .outro{background:linear-gradient(180deg,#0b0b0c,#3a3d44 60%,#9aa0a8)}
.outro svg.mtn{position:absolute;left:0;right:0;bottom:0;width:100%;height:55%}
.outro .shade{height:70%}
.outro .tag3{position:relative;z-index:2;font-family:var(--disp);font-weight:700;text-transform:uppercase;font-size:34px;line-height:.95;margin-top:auto}
.outro .mono{color:rgba(255,255,255,.75);position:relative;z-index:2}
.barcode{height:26px;color:#fff;opacity:.9}

/* тинт-плитки */
.tiles{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.tint{--c:var(--accent);border-radius:16px;padding:12px 13px;background:color-mix(in srgb,var(--c) 10%,transparent);border:1px solid color-mix(in srgb,var(--c) 32%,transparent)}
.tint .mono{display:flex;align-items:center;gap:6px;color:color-mix(in srgb,var(--c) 70%,var(--text))}
.tint .mono svg{width:13px;height:13px}
.tint b{display:block;font-family:var(--disp);font-size:30px;font-weight:600;margin-top:6px;line-height:1}
.tint small{color:var(--hint);font-size:12px}
.flick svg{animation:flick 1.3s ease-in-out infinite;transform-origin:50% 90%}
@keyframes flick{0%,100%{transform:scale(1) rotate(0)}30%{transform:scale(1.18) rotate(-6deg)}60%{transform:scale(.95) rotate(4deg)}}

/* миссии */
.mission{display:flex;align-items:center;gap:12px;width:100%;text-align:left;padding:14px;border-radius:18px;background:var(--card);border:1px solid var(--card-b);margin-bottom:8px;transition:background .2s,border-color .2s,transform .12s}
.mission .box{width:28px;height:28px;border-radius:9px;border:1.5px solid var(--card-b);display:grid;place-items:center;flex:none;transition:all .2s}
.mission.done .box{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.mission.done .t{text-decoration:line-through;color:var(--hint)}
.mission.just .box{animation:boxpop .5s cubic-bezier(.3,1.6,.5,1)}
.mission.just{animation:glowpulse .7s ease-out}
@keyframes boxpop{0%{transform:scale(.4) rotate(-20deg)}100%{transform:scale(1) rotate(0)}}
@keyframes glowpulse{0%{box-shadow:0 0 0 0 color-mix(in srgb,var(--accent) 60%,transparent)}100%{box-shadow:0 0 0 14px transparent}}
.mission.bonus{border-style:dashed}
.mission.charm{border-color:color-mix(in srgb,#b79cff 45%,transparent);background:linear-gradient(120deg,color-mix(in srgb,#b79cff 14%,transparent),var(--card))}
.mission .t{font-weight:600}
.mission .xp{font-family:var(--mono);font-size:11px;color:var(--accent);font-weight:700;white-space:nowrap}
.tag{font-family:var(--mono);font-size:9.5px;letter-spacing:.1em;padding:3px 6px;border-radius:6px;border:1px solid var(--card-b);color:var(--hint);text-transform:uppercase}

/* сундук, тизер, фичи */
.chest{display:flex;align-items:center;gap:14px;background:linear-gradient(120deg,color-mix(in srgb,var(--gold) 22%,transparent),var(--card));border-color:color-mix(in srgb,var(--gold) 45%,transparent)}
.chest .ci{font-size:34px;animation:wobble 2.2s ease-in-out infinite;display:inline-block}
@keyframes wobble{0%,70%,100%{transform:rotate(0)}75%{transform:rotate(-12deg) scale(1.08)}80%{transform:rotate(10deg) scale(1.08)}85%{transform:rotate(-8deg)}90%{transform:rotate(5deg)}}
.teaser{position:relative;overflow:hidden}
.teaser .bar2{height:8px;border-radius:8px;background:var(--line);overflow:hidden;margin-top:10px;position:relative}
.teaser .bar2 i{display:block;height:100%;background:var(--accent);border-radius:8px;position:relative;overflow:hidden}
.teaser .bar2 i:after{content:"";position:absolute;inset:0;background:linear-gradient(90deg,transparent,rgba(255,255,255,.55),transparent);animation:shine 2s infinite}
@keyframes shine{from{transform:translateX(-100%)}to{transform:translateX(100%)}}
.moods{display:flex;justify-content:space-between;gap:6px;margin-top:10px}
.moods button{flex:1;height:52px;border-radius:14px;background:var(--card);border:1px solid var(--card-b);font-size:24px;transition:transform .2s,background .2s}
.moods button.on{background:var(--accent);transform:translateY(-3px) scale(1.06)}
.gin{width:100%;height:44px;border-radius:12px;border:1px solid var(--card-b);background:var(--card);padding:0 12px;outline:none;margin-top:8px}
.gin:focus{border-color:var(--accent)}
.chal{padding:12px 0;border-bottom:1px solid var(--line)}
.chal:last-child{border-bottom:0;padding-bottom:0}

/* дроп дня */
.drop{position:relative;overflow:hidden}
.drop .n{font-family:var(--disp);font-size:64px;line-height:.8;color:transparent;position:absolute;right:14px;top:12px}
.drop p{margin:10px 0 0;font-size:16px;font-weight:600;line-height:1.4;max-width:85%}
.drop.hot{color:#1c100b;border:0}
.drop.hot .mono{color:rgba(28,16,11,.6)}
.drop.hot .n{-webkit-text-stroke:1px rgba(28,16,11,.3)}

/* покупки */
.item{display:flex;align-items:center;gap:12px;padding:12px 0;border-bottom:1px solid var(--line)}
.item:last-child{border-bottom:0;padding-bottom:0}
.status{font-family:var(--mono);font-size:10px;letter-spacing:.06em;text-transform:uppercase;padding:7px 10px;border-radius:10px;font-weight:700;white-space:nowrap;transition:all .2s}
.st-none{background:var(--card);border:1px solid var(--card-b);color:var(--hint)}
.st-ordered{background:color-mix(in srgb,var(--warn) 14%,transparent);color:var(--warn);border:1px solid color-mix(in srgb,var(--warn) 35%,transparent)}
.st-arrived{background:color-mix(in srgb,var(--ok) 14%,transparent);color:var(--ok);border:1px solid color-mix(in srgb,var(--ok) 35%,transparent)}

/* таббар */
.tabs{position:fixed;left:0;right:0;bottom:0;display:flex;justify-content:center;padding:0 12px calc(12px + env(safe-area-inset-bottom));z-index:20;pointer-events:none}
.tabs .in{pointer-events:auto;display:flex;max-width:480px;width:100%;background:color-mix(in srgb,var(--solid) 82%,transparent);border:1px solid var(--card-b);border-radius:24px;padding:6px;backdrop-filter:blur(20px);-webkit-backdrop-filter:blur(20px);box-shadow:0 10px 40px rgba(0,0,0,.25)}
.tab{flex:1;display:flex;flex-direction:column;align-items:center;gap:3px;font-size:10px;font-weight:700;letter-spacing:.03em;color:var(--hint);padding:7px 0;border-radius:18px;transition:background .3s,color .3s,transform .12s}
.tab svg{width:22px;height:22px;transition:transform .3s cubic-bezier(.3,1.6,.5,1)}
.tab.on{color:var(--on-accent);background:var(--accent)}
.tab.on svg{animation:tabhop .45s cubic-bezier(.3,1.6,.5,1)}
@keyframes tabhop{0%{transform:translateY(4px) scale(.8)}100%{transform:none}}

/* журнал */
.seg{display:flex;background:var(--card);border:1px solid var(--card-b);border-radius:14px;padding:4px;margin-bottom:14px}
.seg button{flex:1;padding:10px 6px;border-radius:10px;font-size:13px;font-weight:700;color:var(--hint);transition:all .25s}
.seg button.on{background:var(--text);color:var(--bg)}
.jt{display:flex;gap:6px;overflow-x:auto;margin:0 -16px 14px;padding:2px 16px;scrollbar-width:none}
.jt::-webkit-scrollbar{display:none}
.jt button{flex:none;padding:9px 14px;border-radius:12px;background:var(--card);border:1px solid var(--card-b);font-weight:700;font-size:13px;color:var(--hint);transition:all .25s}
.jt button.on{background:var(--text);color:var(--bg);border-color:var(--text)}
.feature{position:relative;border-radius:26px;overflow:hidden;min-height:340px;color:#fff;margin-bottom:12px;display:flex;flex-direction:column;justify-content:flex-end;padding:18px;text-align:left;width:100%}
.feature .art{position:absolute;inset:0;transition:transform .6s}
.feature:hover .art{transform:scale(1.04)}
.feature .in{position:relative;z-index:2}
.feature .disp{font-size:44px}
.feature .mono{color:rgba(255,255,255,.75)}
.acard{display:flex;gap:14px;align-items:stretch;width:100%;text-align:left;padding:10px;border-radius:20px;background:var(--card);border:1px solid var(--card-b);margin-bottom:10px}
.acard .thumb{width:96px;flex:none;border-radius:14px;overflow:hidden;position:relative;min-height:104px}
.acard .t{font-weight:800;font-size:15.5px;line-height:1.25;margin:6px 0 4px}
.lesson{display:flex;align-items:center;gap:14px;width:100%;text-align:left;padding:16px;border-radius:20px;background:var(--card);border:1px solid var(--card-b);margin-bottom:8px}
.lesson .num{font-family:var(--disp);font-size:40px;line-height:.9;color:var(--accent);width:52px;flex:none}
.lesson.read .num{color:var(--hint)}
.lesson .t{font-weight:800;font-size:15.5px;line-height:1.25}
.check{width:24px;height:24px;border-radius:50%;background:var(--ok);color:#04130b;display:grid;place-items:center;flex:none}
.books{display:grid;grid-template-columns:1fr 1fr;gap:10px}
.book{text-align:left;display:flex;flex-direction:column;gap:8px}
.cover{position:relative;aspect-ratio:3/4.2;border-radius:6px 16px 16px 6px;overflow:hidden;padding:12px 12px 12px 18px;display:flex;flex-direction:column;color:#fff;box-shadow:0 10px 24px rgba(0,0,0,.25);transition:transform .3s}
.book:hover .cover{transform:translateY(-3px) rotate(-1deg)}
.cover:before{content:"";position:absolute;left:0;top:0;bottom:0;width:7px;background:rgba(0,0,0,.25)}
.cover .disp{font-size:22px;margin-top:auto;position:relative}
.cover .mono{color:rgba(255,255,255,.8);position:relative}
.bstat{font-family:var(--mono);font-size:9.5px;letter-spacing:.08em;text-transform:uppercase;padding:4px 7px;border-radius:7px;align-self:flex-start;font-weight:700}
.bs-want{background:var(--card);border:1px solid var(--card-b);color:var(--hint)}
.bs-reading{background:color-mix(in srgb,var(--accent) 20%,transparent);color:var(--accent)}
.bs-done{background:color-mix(in srgb,var(--ok) 18%,transparent);color:var(--ok)}
.prod{display:flex;gap:12px;align-items:center;padding:12px 0;border-bottom:1px solid var(--line)}
.prod:last-child{border-bottom:0;padding-bottom:0}
.prod .sq{width:46px;height:46px;border-radius:12px;flex:none;display:grid;place-items:center;font-family:var(--mono);font-size:9px;font-weight:700;letter-spacing:.06em}
.prod .n{font-weight:700;line-height:1.25}
.tier{font-family:var(--mono);font-size:12px;font-weight:700;white-space:nowrap}
.tier span{opacity:.25}

/* читалка */
.reader{position:fixed;inset:0;z-index:40;background:var(--bg);overflow-y:auto;animation:up .32s cubic-bezier(.2,.8,.2,1)}
@keyframes up{from{transform:translateY(40px);opacity:0}to{transform:none;opacity:1}}
.reader .rcover{position:relative;min-height:300px;color:#fff;display:flex;flex-direction:column;justify-content:flex-end;padding:20px;overflow:hidden}
.reader .rcover .art{position:absolute;inset:0}
.reader .rcover .in{position:relative;z-index:2}
.reader .close{position:absolute;top:14px;right:14px;z-index:3;width:42px;height:42px;border-radius:50%;background:rgba(0,0,0,.35);backdrop-filter:blur(10px);display:grid;place-items:center;color:#fff}
.reader .body{max-width:520px;margin:0 auto;padding:20px 18px 40px;font-size:16.5px;line-height:1.65}
.reader .body p{margin:0 0 16px}
.reader .body h3{font-family:var(--disp);text-transform:uppercase;font-size:22px;margin:26px 0 10px;letter-spacing:.01em}
.reader .body .quote{border-left:3px solid var(--accent);padding:4px 0 4px 14px;font-weight:700;font-size:18px;margin:20px 0}
.reader .body > *{animation:fadeup .5s both}
.reader .body > *:nth-child(2){animation-delay:.05s}.reader .body > *:nth-child(3){animation-delay:.1s}.reader .body > *:nth-child(4){animation-delay:.15s}.reader .body > *:nth-child(n+5){animation-delay:.2s}
@keyframes fadeup{from{opacity:0;transform:translateY(12px)}to{opacity:1;transform:none}}

/* модалки */
.modal{position:fixed;inset:0;z-index:55;background:rgba(0,0,0,.6);backdrop-filter:blur(10px);-webkit-backdrop-filter:blur(10px);display:grid;place-items:center;padding:20px;animation:fade .25s}
@keyframes fade{from{opacity:0}to{opacity:1}}
.sheet{position:relative;width:100%;max-width:400px;border-radius:30px;background:var(--solid);border:1px solid var(--card-b);padding:26px 22px 22px;text-align:center;overflow:hidden;animation:popin .5s cubic-bezier(.3,1.5,.5,1)}
@keyframes popin{from{opacity:0;transform:scale(.8) translateY(20px)}to{opacity:1;transform:none}}
.rays{position:absolute;left:50%;top:120px;width:560px;height:560px;margin:-280px 0 0 -280px;border-radius:50%;background:repeating-conic-gradient(color-mix(in srgb,var(--accent) 22%,transparent) 0 9deg,transparent 9deg 18deg);-webkit-mask:radial-gradient(circle,#000 20%,transparent 65%);mask:radial-gradient(circle,#000 20%,transparent 65%);animation:spin 14s linear infinite;pointer-events:none}
@keyframes spin{to{transform:rotate(360deg)}}
.lvnum{position:relative;font-family:var(--disp);font-size:130px;line-height:.9;color:var(--accent);animation:lvpop .8s cubic-bezier(.3,1.7,.5,1) .15s both;text-shadow:0 0 40px color-mix(in srgb,var(--accent) 50%,transparent)}
@keyframes lvpop{from{transform:scale(0) rotate(-20deg);opacity:0}to{transform:none;opacity:1}}
.unl{display:flex;align-items:center;gap:12px;text-align:left;padding:12px;border-radius:16px;background:var(--card);border:1px solid var(--card-b);margin-top:8px;animation:fadeup .5s both}
.unl .ui{width:40px;height:40px;border-radius:12px;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font-size:18px;flex:none}
.ring{width:220px;height:220px;margin:6px auto 10px;position:relative}
.ring svg{width:100%;height:100%;transform:rotate(-90deg)}
.ring .tt{position:absolute;inset:0;display:grid;place-items:center;font-family:var(--disp);font-size:56px}
.share{position:relative;border-radius:24px;overflow:hidden;min-height:440px;color:#fff;text-align:left;padding:20px;display:flex;flex-direction:column}

/* путь */
.track-lv{display:flex;gap:8px;overflow-x:auto;margin:14px -16px 0;padding:4px 16px;scrollbar-width:none;scroll-behavior:smooth}
.track-lv::-webkit-scrollbar{display:none}
.node{flex:none;width:92px;padding:10px;border-radius:16px;background:rgba(255,255,255,.06);border:1px solid rgba(255,255,255,.1);text-align:left}
.node.past{opacity:.5}
.node.now{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.node .nb{font-family:var(--disp);font-size:26px;line-height:1}
.node .nl{font-size:10.5px;line-height:1.25;margin-top:6px;font-weight:700;min-height:26px}
.heat{display:grid;grid-template-columns:repeat(7,1fr);gap:5px;margin-top:12px}
.heat i{aspect-ratio:1;border-radius:6px;background:var(--line)}
.heat i.f{background:var(--accent)}
.heat i.today{outline:1.5px solid var(--text);outline-offset:1px}
.bars .b{margin:12px 0}
.pbar{height:6px;border-radius:6px;background:var(--line);overflow:hidden;margin-top:6px}
.pbar i{display:block;height:100%;background:var(--accent);border-radius:6px;transform-origin:left}
.tl{position:relative;padding-left:28px}
.tl:before{content:"";position:absolute;left:9px;top:8px;bottom:8px;width:1px;background:var(--card-b)}
.tl .d{position:relative;margin-bottom:20px}
.tl .d:last-child{margin-bottom:0}
.tl .d:before{content:"";position:absolute;left:-24px;top:5px;width:11px;height:11px;border-radius:50%;background:var(--bg);border:2px solid var(--accent)}
.tl .d.closed:before{background:var(--accent)}
.tl .dt{font-weight:800;margin:3px 0 5px;line-height:1.3}
.tl ul{margin:0;padding-left:16px;color:var(--hint);font-size:13.5px}
.badges{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin-top:12px}
.badge{text-align:center;padding:12px 6px;border-radius:16px;background:var(--card);border:1px solid var(--card-b)}
.badge .bi{width:46px;height:46px;margin:0 auto 6px;border-radius:50%;display:grid;place-items:center;font-size:22px;background:color-mix(in srgb,var(--accent) 18%,transparent)}
.badge b{display:block;font-size:12px;line-height:1.2}
.badge small{font-size:10.5px;color:var(--hint);line-height:1.2;display:block;margin-top:2px}
.badge.off{opacity:.35;filter:grayscale(1)}
.mchart{display:flex;align-items:flex-end;gap:5px;height:90px;margin-top:12px}
.mchart i{flex:1;border-radius:6px 6px 3px 3px;background:var(--line);min-height:6px;transform-origin:bottom}
.app.enter .mchart i{animation:growY .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes growY{from{transform:scaleY(0)}to{transform:scaleY(1)}}
.cmp{display:grid;grid-template-columns:1fr 1fr;gap:8px}
.cmp img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:16px;display:block}
.grid3{display:grid;grid-template-columns:repeat(3,1fr);gap:6px;margin-top:10px}
.grid3 img{width:100%;aspect-ratio:3/4;object-fit:cover;border-radius:12px;display:block}
.goal{display:flex;align-items:center;gap:10px;margin-top:10px}
.goal .gk{width:68px;flex:none}
.goal input{flex:1;height:42px;border-radius:12px;border:1px solid var(--card-b);background:var(--card);padding:0 12px;outline:none;min-width:0}
.goal .box{width:30px;height:30px;border-radius:9px;border:1.5px solid var(--card-b);display:grid;place-items:center;flex:none}
.goal .box.on{background:var(--ok);border-color:var(--ok);color:#04130b}

/* чат */
.coach-head{display:flex;align-items:center;gap:12px;margin-bottom:16px}
.ava{width:48px;height:48px;border-radius:16px;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;font-family:var(--disp);font-size:22px;flex:none}
.chat{display:flex;flex-direction:column;gap:8px;padding-bottom:150px}
.msg{max-width:85%;padding:11px 14px;border-radius:20px;white-space:pre-wrap;word-wrap:break-word}
.msg.new{animation:pop .3s cubic-bezier(.3,1.4,.5,1)}
.msg.ai{background:var(--card);border:1px solid var(--card-b);align-self:flex-start;border-bottom-left-radius:6px;transform-origin:left bottom}
.msg.me{background:var(--accent);color:var(--on-accent);align-self:flex-end;border-bottom-right-radius:6px;font-weight:600;transform-origin:right bottom}
.msg .mini{margin-top:12px;padding:14px;border-radius:14px;background:var(--bg);border:1px solid var(--card-b);white-space:normal}
@keyframes pop{from{opacity:0;transform:translateY(8px) scale(.94)}to{opacity:1;transform:none}}
.typing span{display:inline-block;width:7px;height:7px;border-radius:50%;background:var(--hint);margin:0 2px;animation:bl 1s infinite}
.typing span:nth-child(2){animation-delay:.15s}.typing span:nth-child(3){animation-delay:.3s}
@keyframes bl{0%,80%,100%{opacity:.25;transform:translateY(0)}40%{opacity:1;transform:translateY(-3px)}}
.composer{position:fixed;left:0;right:0;bottom:calc(86px + env(safe-area-inset-bottom));padding:0 12px;z-index:19}
.composer .in{max-width:520px;margin:0 auto}
.qr{display:flex;gap:6px;overflow-x:auto;padding-bottom:8px;scrollbar-width:none}
.qr::-webkit-scrollbar{display:none}
.qr button{flex:none;padding:8px 13px;border-radius:20px;background:color-mix(in srgb,var(--solid) 85%,transparent);border:1px solid var(--card-b);font-size:12.5px;font-weight:700;white-space:nowrap;backdrop-filter:blur(10px)}
.composer form{display:flex;gap:8px}
.composer input{flex:1;height:50px;border-radius:25px;border:1px solid var(--card-b);background:color-mix(in srgb,var(--solid) 92%,transparent);padding:0 18px;outline:none;backdrop-filter:blur(10px)}
.composer input:focus{border-color:var(--accent)}
.send{width:50px;height:50px;border-radius:50%;background:var(--accent);color:var(--on-accent);display:grid;place-items:center;flex:none}

/* настройки и онбординг */
.chips{display:flex;flex-wrap:wrap;gap:8px}
.chip{padding:11px 15px;border-radius:14px;background:var(--card);border:1px solid var(--card-b);font-size:14px;font-weight:700;transition:all .2s}
.chip.on{background:var(--accent);color:var(--on-accent);border-color:var(--accent)}
.lbl{margin:18px 0 8px}
.themes{display:grid;grid-template-columns:repeat(4,1fr);gap:8px}
.themes button{position:relative;border-radius:16px;border:1.5px solid var(--card-b);overflow:hidden;text-align:left;transition:transform .2s,border-color .2s}
.themes button.on{border-color:var(--accent);transform:translateY(-2px)}
.themes button.locked .pv{filter:grayscale(.7) brightness(.6)}
.themes .lk{position:absolute;top:6px;right:6px;font-family:var(--mono);font-size:9px;font-weight:700;padding:3px 5px;border-radius:6px;background:rgba(0,0,0,.6);color:#fff}
.themes .pv{height:58px;position:relative}
.themes .nm{padding:7px 9px;font-weight:700;font-size:12px}
.sw{display:flex;gap:10px;flex-wrap:wrap}
.sw button{width:38px;height:38px;border-radius:50%;border:3px solid var(--bg);outline:1.5px solid var(--card-b);transition:transform .2s;font-family:var(--mono);font-size:9px;font-weight:700}
.sw button.on{outline:2px solid var(--text);transform:scale(1.1)}
.field{width:100%;height:48px;border-radius:14px;border:1px solid var(--card-b);background:var(--card);padding:0 14px;outline:none}
.field:focus{border-color:var(--accent)}
.opt{display:flex;align-items:flex-start;gap:12px;width:100%;text-align:left;padding:15px;border-radius:18px;background:var(--card);border:1px solid var(--card-b);margin-bottom:8px}
.opt .box{width:24px;height:24px;border-radius:8px;border:1.5px solid var(--card-b);display:grid;place-items:center;flex:none;margin-top:1px;transition:all .2s}
.opt.on .box{background:var(--accent);border-color:var(--accent);color:var(--on-accent)}
.steps{display:flex;gap:5px;margin:4px 0 22px}
.steps i{flex:1;height:3px;border-radius:3px;background:var(--line);transition:background .4s}
.steps i.on{background:var(--accent)}
.photo-drop{border:1.5px dashed var(--card-b);border-radius:26px;aspect-ratio:3/4;display:grid;place-items:center;text-align:center;position:relative;overflow:hidden;background:var(--card);cursor:pointer}
.photo-drop img{position:absolute;inset:0;width:100%;height:100%;object-fit:cover}
.photo-drop .oval{position:absolute;inset:13% 21% 22%;border:1.5px dashed var(--accent);border-radius:50%;animation:breathe 2.4s ease-in-out infinite}
@keyframes breathe{50%{transform:scale(1.03);opacity:.6}}
.spin{width:64px;height:64px;border-radius:50%;border:3px solid var(--line);border-top-color:var(--accent);animation:sp .9s linear infinite;margin:60px auto 28px}
@keyframes sp{to{transform:rotate(360deg)}}
.check-line{opacity:.25;transition:opacity .3s,transform .3s;margin:10px 0;font-family:var(--mono);font-size:12.5px;letter-spacing:.06em;text-transform:uppercase;transform:translateX(-6px)}
.check-line.on{opacity:1;color:var(--accent);transform:none}
.banner{border-radius:16px;padding:12px 14px;font-size:13px;margin-bottom:12px;background:color-mix(in srgb,var(--accent) 10%,transparent);border:1px solid color-mix(in srgb,var(--accent) 30%,transparent)}
.celebrate{border-radius:18px;padding:16px;margin-bottom:12px;background:var(--accent);color:var(--on-accent);display:flex;align-items:center;justify-content:space-between;animation:pop .4s cubic-bezier(.3,1.5,.5,1)}
.celebrate b{font-family:var(--disp);font-size:24px;text-transform:uppercase}
.toast{position:fixed;left:50%;top:14px;transform:translate(-50%,-90px);background:var(--text);color:var(--bg);padding:11px 16px;border-radius:14px;font-size:13.5px;font-weight:700;transition:transform .35s cubic-bezier(.3,1.4,.5,1);z-index:60;max-width:90%}
.toast.show{transform:translate(-50%,0)}

/* анимации */
button:active,label.card:active{transform:scale(.97)}
.app.enter{animation:screenIn .4s cubic-bezier(.2,.8,.2,1)}
@keyframes screenIn{from{opacity:0;transform:translateY(10px)}to{opacity:1;transform:none}}
.app.enter .track i,.app.enter .pbar i,.app.enter .bar2 i{animation:grow 1s cubic-bezier(.2,.8,.2,1)}
@keyframes grow{from{transform:scaleX(0)}to{transform:scaleX(1)}}
.app.enter .heat i{animation:fadeup .4s both}
.app.enter .hero .huge{animation:heroIn .7s cubic-bezier(.2,.8,.2,1) both}
@keyframes heroIn{from{opacity:0;transform:translateY(30px);letter-spacing:.08em}to{opacity:1;transform:none}}
.rv{opacity:0;transform:translateY(22px) scale(.98);transition:opacity .55s ease,transform .7s cubic-bezier(.2,.8,.2,1)!important}
.rv.in{opacity:1;transform:none}
.xpfloat{position:fixed;z-index:80;font-family:var(--disp);font-size:24px;color:var(--accent);text-shadow:0 2px 12px rgba(0,0,0,.45);pointer-events:none;white-space:nowrap;animation:xpf 1.1s ease-out forwards}
@keyframes xpf{0%{opacity:0;transform:translate(-50%,-30%) scale(.5)}20%{opacity:1;transform:translate(-50%,-90%) scale(1.2)}100%{opacity:0;transform:translate(-50%,-280%) scale(1)}}
.confetti{position:fixed;left:50%;top:42%;z-index:70;pointer-events:none}
.confetti i{position:absolute;width:8px;height:13px;border-radius:2px;animation:conf 1.4s cubic-bezier(.2,.7,.3,1) forwards}
@keyframes conf{0%{transform:translate(0,0) rotate(0);opacity:1}35%{transform:translate(var(--x),var(--y)) rotate(calc(var(--r) / 2));opacity:1}100%{transform:translate(calc(var(--x) * 1.3),calc(var(--y) + 560px)) rotate(var(--r));opacity:0}}
@media (prefers-reduced-motion: reduce){*,*:before,*:after{animation:none!important;transition:none!important}.rv{opacity:1;transform:none}}
</style>
</head>
<body>
<div class="app" id="app"></div>
<div id="overlay"></div>
<div id="modal"></div>
<div class="toast" id="toast"></div>
<script>
// Адрес бэкенда с настоящей нейросетью. Пока пусто — тренер работает на локальных правилах.
const AI_ENDPOINT = '';

const tg = window.Telegram && window.Telegram.WebApp;
try { tg && tg.ready(); tg && tg.expand(); } catch (e) {}
// Без этого в Telegram свайп вниз при прокрутке сворачивает приложение
try { tg && tg.disableVerticalSwipes && tg.disableVerticalSwipes(); } catch (e) {}
const tgUser = (() => { try { return tg.initDataUnsafe.user || null; } catch (e) { return null; } })();
// Тестовые кнопки видны только по ссылке с ?dev=1
const DEV = /[?&]dev=1/.test(location.search);
const haptic = (type) => { try { if (type === 'success') tg.HapticFeedback.notificationOccurred('success'); else tg.HapticFeedback.impactOccurred(type || 'light'); } catch (e) {} };
const reduceMotion = (() => { try { return matchMedia('(prefers-reduced-motion: reduce)').matches; } catch (e) { return false; } })();

const KEY = 'upgrade_v3';
let S = load();
function load() { try { return JSON.parse(localStorage.getItem(KEY)) || {}; } catch (e) { return {}; } }
function save() { try { localStorage.setItem(KEY, JSON.stringify(S)); } catch (e) { toast('Память заполнена — удали старые фото'); } }

// ---------- данные ----------
const PILLARS = {
  skin:    { name: 'Кожа',      code: 'SKN',  verb: 'уход за кожей', c: '#ffb07c' },
  hair:    { name: 'Волосы',    code: 'HAIR', verb: 'волосы',        c: '#b79cff' },
  body:    { name: 'Тело',      code: 'BODY', verb: 'упражнения',    c: '#6ee7c8' },
  posture: { name: 'Осанка',    code: 'POST', verb: 'осанку',        c: '#ffd166' },
  style:   { name: 'Стиль',     code: 'STYL', verb: 'стиль',         c: '#ff7a9c' },
  sleep:   { name: 'Сон и еда', code: 'SLP',  verb: 'режим',         c: '#7dd3fc' }
};
const TASKS = {
  skin: ['Умыться гелем утром и вечером', 'Нанести увлажняющий крем', 'Нанести SPF перед выходом', 'Выпить 2 литра воды', 'Сменить наволочку'],
  hair: ['Уложить волосы глиной или пастой', 'Сохранить 3 фото стрижек, которые нравятся', 'Помыть голову шампунем под свой тип', 'Подровнять линию шеи и бороду'],
  body: ['20 отжиманий + 30 приседаний', 'Пройти 8 000 шагов', 'Планка 3 × 40 секунд', '3 подхода подтягиваний или австралийских'],
  posture: ['2 минуты у стены: лопатки и затылок прижаты', 'Растяжка грудных мышц 2 × 30 секунд', '5 раз за день проверить осанку'],
